<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>JwtSummary</Name>
      <ViewSelectedBy>
        <TypeName>Jwt</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>Algorithm</Label>
                <PropertyName>Algorithm</PropertyName>
              </ListItem>
              <ListItem>
                <Label>KeyId</Label>
                <PropertyName>KeyId</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Issuer</Label>
                <PropertyName>Issuer</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Subject</Label>
                <PropertyName>Subject</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Audience</Label>
                <PropertyName>Audience</PropertyName>
              </ListItem>
              <ListItem>
                <Label>ExpiresAtUtc</Label>
                <PropertyName>ExpiresAtUtc</PropertyName>
              </ListItem>
              <ListItem>
                <Label>HasSignature</Label>
                <PropertyName>HasSignature</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>JwtHeaderSummary</Name>
      <ViewSelectedBy>
        <TypeName>JwtHeader</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>alg</Label>
                <PropertyName>alg</PropertyName>
              </ListItem>
              <ListItem>
                <Label>typ</Label>
                <PropertyName>typ</PropertyName>
              </ListItem>
              <ListItem>
                <Label>kid</Label>
                <PropertyName>kid</PropertyName>
              </ListItem>
              <ListItem>
                <Label>AdditionalFieldCount</Label>
                <PropertyName>AdditionalFieldCount</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>JwtPayloadSummary</Name>
      <ViewSelectedBy>
        <TypeName>JwtPayload</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>iss</Label>
                <PropertyName>iss</PropertyName>
              </ListItem>
              <ListItem>
                <Label>sub</Label>
                <PropertyName>sub</PropertyName>
              </ListItem>
              <ListItem>
                <Label>aud</Label>
                <PropertyName>Audience</PropertyName>
              </ListItem>
              <ListItem>
                <Label>exp</Label>
                <PropertyName>ExpiresAtUtc</PropertyName>
              </ListItem>
              <ListItem>
                <Label>nbf</Label>
                <PropertyName>NotBeforeUtc</PropertyName>
              </ListItem>
              <ListItem>
                <Label>iat</Label>
                <PropertyName>IssuedAtUtc</PropertyName>
              </ListItem>
              <ListItem>
                <Label>jti</Label>
                <PropertyName>jti</PropertyName>
              </ListItem>
              <ListItem>
                <Label>AdditionalFieldCount</Label>
                <PropertyName>AdditionalFieldCount</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>JwtKeySummary</Name>
      <ViewSelectedBy>
        <TypeName>JwtKey</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>kid</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>kty</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>alg</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>use</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>crv</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>key_ops</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>private</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>kid</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>kty</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>alg</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>use</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>crv</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Operations</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>HasPrivateMaterial</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>JwtKeySetSummary</Name>
      <ViewSelectedBy>
        <TypeName>JwtKeySet</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <Label>KeyCount</Label>
                <PropertyName>KeyCount</PropertyName>
              </ListItem>
              <ListItem>
                <Label>KeyIds</Label>
                <PropertyName>KeyIds</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
