            </ReferencedProperties>
          </PropertySet>
        </Members>
      </MemberSet>
    </Members>
  </Type>
  <Type>
    <Name>JwtPayload</Name>
    <Members>
      <ScriptProperty>
        <Name>Audience</Name>
        <GetScriptBlock>if ($this.aud -is [array]) { return ($this.aud -join ',') } ; return $this.aud</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>ExpiresAtUtc</Name>
        <GetScriptBlock>if ($null -eq $this.exp) { return $null } ; return [DateTimeOffset]::FromUnixTimeSeconds([long]$this.exp).UtcDateTime.ToString('o')</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>NotBeforeUtc</Name>
        <GetScriptBlock>if ($null -eq $this.nbf) { return $null } ; return [DateTimeOffset]::FromUnixTimeSeconds([long]$this.nbf).UtcDateTime.ToString('o')</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>IssuedAtUtc</Name>
        <GetScriptBlock>if ($null -eq $this.iat) { return $null } ; return [DateTimeOffset]::FromUnixTimeSeconds([long]$this.iat).UtcDateTime.ToString('o')</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>AdditionalFieldCount</Name>
        <GetScriptBlock>if ($null -eq $this.AdditionalFields) { return 0 } ; return $this.AdditionalFields.Count</GetScriptBlock>
      </ScriptProperty>
      <MemberSet>
        <Name>PSStandardMembers</Name>
        <Members>
          <PropertySet>
            <Name>DefaultDisplayPropertySet</Name>
            <ReferencedProperties>
              <Name>iss</Name>
              <Name>sub</Name>
              <Name>Audience</Name>
              <Name>ExpiresAtUtc</Name>
              <Name>NotBeforeUtc</Name>
              <Name>IssuedAtUtc</Name>
              <Name>jti</Name>
              <Name>AdditionalFieldCount</Name>
            </ReferencedProperties>
          </PropertySet>
        </Members>
      </MemberSet>
