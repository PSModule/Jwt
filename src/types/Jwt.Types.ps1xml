  </Type>
  <Type>
    <Name>JwtKey</Name>
    <Members>
      <ScriptProperty>
        <Name>Operations</Name>
        <GetScriptBlock>if ($null -eq $this.key_ops) { return $null } ; return ($this.key_ops -join ',')</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>HasPrivateMaterial</Name>
        <GetScriptBlock>$null -ne $this.d -or $null -ne $this.p -or $null -ne $this.q -or $null -ne $this.dp -or $null -ne $this.dq -or $null -ne $this.qi -or $null -ne $this.oth -or $null -ne $this.k</GetScriptBlock>
      </ScriptProperty>
      <MemberSet>
        <Name>PSStandardMembers</Name>
        <Members>
          <PropertySet>
            <Name>DefaultDisplayPropertySet</Name>
            <ReferencedProperties>
