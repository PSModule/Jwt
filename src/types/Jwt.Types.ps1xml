  <Type>
    <Name>JwtKeySet</Name>
    <Members>
      <ScriptProperty>
        <Name>KeyCount</Name>
        <GetScriptBlock>if ($null -eq $this.keys) { return 0 } ; return $this.keys.Count</GetScriptBlock>
      </ScriptProperty>
      <ScriptProperty>
        <Name>KeyIds</Name>
        <GetScriptBlock>if ($null -eq $this.keys) { return $null } ; return (($this.keys | ForEach-Object { $_.kid } | Where-Object { -not [string]::IsNullOrEmpty($_) }) -join ',')</GetScriptBlock>
      </ScriptProperty>
      <MemberSet>
        <Name>PSStandardMembers</Name>
        <Members>
          <PropertySet>
            <Name>DefaultDisplayPropertySet</Name>
            <ReferencedProperties>
              <Name>KeyCount</Name>
              <Name>KeyIds</Name>
            </ReferencedProperties>
          </PropertySet>
        </Members>
      </MemberSet>
    </Members>
